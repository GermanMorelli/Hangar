{
  "name": "hangar",
  "version": "0.1.0",
  "description": "A Warp-style terminal workspace (vertical tabs, blocks, Claude Code agent toolbar) with a fully customizable design. One process, zero dependencies.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "open": "node server.js --open",
    "test": "node test/smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0",
    "ws": "8.18.3"
  }
}
